# Kitty Ledger - every variable the CLI reads. Copy to .env and fill in; never commit .env.

# Soroban RPC endpoint and network passphrase. Testnet defaults shown.
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Contract ids printed by scripts/deploy-testnet.sh (C...). Empty until deployed.
CAMPAIGN_CONTRACT_ID=
REGISTRY_CONTRACT_ID=

# Token the campaign collects: the Stellar Asset Contract id of USDC on the chosen
# network (C...). On testnet, deploy-testnet.sh wraps a test asset and prints it.
TOKEN_CONTRACT_ID=

# Secret key (S...) of the account that signs CLI transactions: the organizer for
# `create`/`close`, a contributor for `contribute`, a committee member for
# `propose`/`approve`. Never a mainnet key with real funds on a shared machine.
SECRET_KEY=

# Optional JSON map { "G...": "Display name" } used by `status`/`export` and the
# ledger page. Relative to app/, where the CLI runs; web/names.json holds the seed names.
NAMES_FILE=web/names.json
